# Pin constraints for the ice40-breakout board (projects/ice40-breakout).
#
# These are the REAL as-built package pins from
# projects/ice40-breakout/BOM.md — NOT the iCEBreaker/PMOD numbers a stock
# .pcf would use. (fpga-blink learned this the hard way; the stock icebreaker
# .pcf maps signals to the wrong physical pins on this board.)
#
# Runtime SPI command bus (STM32 SPI master -> FPGA slave):
#   SPI_CLK  net RUNTIME_SPI_CLK  = pin 20 -> header H4-23  (STM32 PA5, SPI1_SCK)
#   SPI_MOSI net RUNTIME_SPI_MOSI = pin 21 -> header H4-22  (STM32 PA7, SPI1_MOSI)
#   SPI_CS   net RUNTIME_SPI_CS   = pin 18 -> header H3-25  (STM32 PA4, GPIO)
set_io SPI_CLK  20
set_io SPI_MOSI 21
set_io SPI_CS   18

# LED outputs — each drives an external LED (pin -> ~330R -> LED -> GND) AND
# an STM32 feedback input so the firmware can read its own commands back:
#   LED0 = pin 48 (IOB_4A) -> header H3-8 -> STM32 PC0 (feedback in)
#   LED1 = pin 2  (IOB_6A) -> header H3-9 -> STM32 PC1 (feedback in)
set_io LED0 48
set_io LED1 2
