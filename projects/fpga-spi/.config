# fpga-spi — STM32F411RE configures an iCE40, then drives 2 FPGA LEDs over the
# runtime SPI bus and reads them back to self-verify. Minimal RTOS app: config
# bus (SPI3) + runtime bus (SPI1, slow) + iCE40 loader + scheduler (for UART).

# Architecture
CONFIG_CPU_CORTEX_M4=y
CONFIG_CPU_CORTEX_M0PLUS=n
CONFIG_SMP=n
CONFIG_SMP_NUM_CPUS=1

# Drivers
CONFIG_CLOCK=y
CONFIG_CLOCK_STM32=y
CONFIG_CLOCK_RP2040=n
CONFIG_UART=y
CONFIG_UART_STM32=y
CONFIG_UART_PL011=n
CONFIG_GPIO=y
CONFIG_GPIO_STM32=y
CONFIG_GPIO_RP2040=n
CONFIG_SPI=y
CONFIG_SPI_STM32=y
CONFIG_FPGA_ICE40=y
CONFIG_FLASH=n
CONFIG_GPIO_KEYS=n
CONFIG_GPIO_LEDS=n

# Kernel
CONFIG_SCHED=y
CONFIG_SYNC=y
CONFIG_MSGQ=n
CONFIG_SYSTICK=y

# Libraries
CONFIG_HEAP=n
CONFIG_MEMSLAB=n
CONFIG_LOG=n
CONFIG_SHELL=n

# Disabled
CONFIG_FS=n
CONFIG_TINYFS=n
CONFIG_MPU=n
CONFIG_USERSPACE=n
CONFIG_ELFLOADER=n
CONFIG_PM=n
