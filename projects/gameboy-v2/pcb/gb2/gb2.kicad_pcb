		(effects
			(font
				(size 1 1)
				(thickness 0.12)
			)
			(justify left)
		)
	)
	(gr_text "FIT (2090 PCB centred; controls need >= 3 mm to the module outline, mm): D-pad: clear 5.3; Start: clear 3.1; Select: clear 3.2; B: clear 3.3; A: clear 16.3; L shoulder: clear 1.4; R shoulder: clear 1.4; speaker (+buffer): clear 0.6"
		(at 20 122 0)
		(layer "Cmts.User")
		(uuid "2a903d57-00d1-4f73-a22a-30aa2b86e469")
		(effects
			(font
				(size 1 1)
				(thickness 0.12)
			)
			(justify left)
		)
	)
	(gr_text "DEPTH: cell sits IN the board cutout under the 2090 (module back is 11 above the board; 8.5 cell + 2.65 module parts fit) -> 2090 glass 16.7 above board + 1.6 PCB + ~1 back-side parts + ~3 shells = ~22 mm vs GBA 24.5"
		(at 20 124.5 0)
