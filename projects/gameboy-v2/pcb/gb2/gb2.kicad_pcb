			)
			(justify left)
		)
	)
	(gr_text "FIT (2090 PCB centred; controls need >= 3 mm to the module outline, mm): D-pad: clear 5.3; Start: clear 3.1; Select: clear 3.2; B: clear 3.3; A: clear 16.3; L shoulder: clear 1.4; R shoulder: clear 1.4; speaker (+buffer): clear 0.6"
		(at 20 122 0)
		(layer "Cmts.User")
		(uuid "3610c13e-f0c3-4cbd-b0f6-2e57c2b916ab")
		(effects
			(font
				(size 1 1)
				(thickness 0.12)
			)
			(justify left)
		)
	)
