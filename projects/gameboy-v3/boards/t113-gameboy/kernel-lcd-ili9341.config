# kernel-lcd-ili9341.config — t113-gameboy BOARD-level kernel fragment for the
# OPTIONAL Adafruit 2.4" ILI9341 SPI panel (opt-in via LCD=ili9341). board.conf names
# it in KERNEL_LCD_CONFIG_FRAGMENT; the mainline-kernel recipe applies it (plus the
# lcd-ili9341.dtsi DT overlay) ONLY when LCD=ili9341, as a second configure round.
#
# TINYDRM_ILI9341 auto-selects DRM_MIPI_DBI/DRM_KMS_HELPER/DRM_GEM_DMA_HELPER/
# BACKLIGHT_CLASS_DEVICE. FBDEV_EMULATION gives the DRM->fbdev console; FB_DEVICE
# actually creates the /dev/fb0 CHAR NODE (without it the driver paints the console
# but no /dev/fb0 exists, so `cat > /dev/fb0` can't work — verified on silicon).
# FB_DEVICE only needs FB_CORE (already on via sunxi_defconfig); the full legacy
# CONFIG_FB stack is NOT needed.
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_TINYDRM_ILI9341=y
CONFIG_FB_DEVICE=y
