# RGB666 parallel (DPI) panel bring-up — kernel .config deltas.
# The sun4i/sun8i DRM pipeline (DRM_SUN4I / SUN8I_MIXER / TCON_TOP) + DRM_PANEL_SIMPLE +
# BACKLIGHT_PWM are already =y in sunxi_defconfig. The only genuine gaps are the DRM->fbdev
# emulation console and the /dev/fb0 char node (same pair the ILI9341 needed).
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB_DEVICE=y
