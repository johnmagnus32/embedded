# kernel-debug-ll.config — compiled-in UART debugging, for bringing up a kernel that says nothing.
#
# DEBUG_LL puts the debug UART's address in the image (DEBUG_SUNXI_UART0 -> 0x01c28000) instead of
# discovering it from the DTB, and EARLY_PRINTK exposes it as `earlyprintk` on the command line. That is
# the output you need when the DTB-driven `earlycon` never registers — or when the kernel dies before it
# could. DEBUG_UNCOMPRESS (which would make the decompressor itself talk) is NOT available here: it
# depends on !ARCH_MULTIPLATFORM, and every modern sunxi kernel is multiplatform.
#
# Costs a little size and pins the kernel to one UART, so it is a bring-up fragment, not a default.
CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_LL=y
CONFIG_DEBUG_SUNXI_UART0=y
CONFIG_EARLY_PRINTK=y
