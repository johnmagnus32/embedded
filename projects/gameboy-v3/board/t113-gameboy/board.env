# board.env — t113-gameboy board BUILD FACTS consumed by the OSS build backends.
#
# These are inputs the generic fetch/build recipes (forge/backends/{uboot,kernel}.sh
# via lib.sh) read for THIS board: which defconfig, the board device tree, the
# console. They sit beside the board's other inputs (board.mk = provider targets,
# layout.env = memory/storage, *.dtsi = DT overlays). Strict KEY=value, bash-sourceable.
#
# NB: only the MAINLINE/OSS path consumes these (defconfig names are U-Boot/Linux
# concepts). The custom kernel/bootloader carry their own board facts in their
# source (kernel/include/board.h) — see docs/LINUX_BUILD_SYSTEM_REFACTOR.md.

# --- U-Boot ------------------------------------------------------------------
UBOOT_DEFCONFIG="mangopi_mq_r_defconfig"
# The board device tree U-Boot builds as its control DTB AND ships for the kernel.
UBOOT_BOARD_DT="sun8i-t113s-mangopi-mq-r-t113"
# Console on UART0/PE2-PE3 (our t113-breakout wiring). The stock defconfig puts it
# on UART3/PB6-PB7 (CONS_INDEX=4). CONS_INDEX=1 fixes the SPL console pinmux to
# PE2/PE3; the control-DTB uart0-console.dtsi overlay fixes U-Boot *proper* (DM
# serial reads stdout-path from the DTB). CONS_INDEX alone is a split-brain trap.
UBOOT_CONS_INDEX="1"

# --- Linux kernel ------------------------------------------------------------
KERNEL_DEFCONFIG="sunxi_defconfig"        # 32-bit ARM; 8250_DW UART, MMC_SUNXI, D1/T113 CCU+pinctrl
KERNEL_IMAGE_TARGET="zImage"              # ARMv7 compressed kernel (bootz); board/arch boot-flow choice
KERNEL_DTB="${UBOOT_BOARD_DT}.dtb"        # same board DTB name; kernel builds it under allwinner/
KERNEL_DTB_SUBDIR="allwinner"             # arch/arm/boot/dts/allwinner/
# With serial0=&uart0 (uart0-console.dtsi), Linux names uart0 "ttyS0", so the
# kernel command line console must be ttyS0.
KERNEL_CONSOLE="ttyS0,115200"
