# layout.env — the t113-gameboy board's MEMORY + STORAGE layout (a board input).
#
# These are LAYOUT CHOICES for this board, not chip facts (a different T113 board
# could choose differently — see docs/LINUX_BUILD_SYSTEM_REFACTOR.md "Why there is
# no soc/ tier yet"). The build engine (forge / build.sh) consumes these; it does
# not own them. Sourced by env.sh, so every step + the bundle manifest sees them.
#
# The only silicon-pinned address is DRAM_BASE = 0x40000000 (the memory canvas);
# WHERE we place kernel/DTB/initramfs on it is this board's decision.

# --- NOR flash layout (offsets into the on-board W25Q128 SPI-NOR) -------------
# Must match bootloader/nor_layout.h + NOR-LAYOUT.md. The GV3NOR1 table sits at 0.
NOR_TABLE_OFF=0x000000        # GV3NOR1 component table (custom loader reads this)
NOR_KERNEL_OFF=0x010000       # zImage
NOR_DTB_OFF=0x610000          # board DTB
NOR_INITRD_OFF=0x620000       # initramfs.cpio.gz

# --- DRAM load addresses (where components land before boot) ------------------
# DRAM_BASE 0x40000000 (silicon). These placements match the custom loader +
# board/*/boot.cmd (U-Boot path).
DRAM_KERNEL=0x41000000
DRAM_DTB=0x41800000
DRAM_INITRD=0x41c00000

# --- SD full-disk image layout (MEDIA=sd) -------------------------------------
SDIMAGE_SIZE_MB=64            # plenty for ~7 MB of payload; keeps the .img small
SDIMAGE_PART_START_MB=1       # partition 1 starts at 1 MiB (never clobbers U-Boot)
SDIMAGE_UBOOT_SEEK_KB=8       # BROM reads SPL at the 8 KiB offset (sector 16)
