#!/bin/sh
# /init — PID 1 for the gameboy-v3 initramfs.
#
# The kernel extracts the initramfs cpio into the initial rootfs and executes
# /init as PID 1. It must NOT exit — if PID 1 returns, the kernel panics. So we
# mount the essential virtual filesystems and then hand off to an interactive
# shell that keeps running.
#
# This is the Phase-1 "boot to a prompt over UART0" target. It is deliberately
# minimal: no networking, no services — just enough to prove the whole chain
# (BROM → SPL → U-Boot → kernel → userspace → shell) works on real silicon.

# /proc and /sys: needed by lots of tools and by 'mount' itself for niceties.
mount -t proc     none /proc
mount -t sysfs    none /sys
# /dev: devtmpfs auto-populates device nodes (the kernel has CONFIG_DEVTMPFS).
# A static /dev/console also exists in the cpio as a fallback for early output.
mount -t devtmpfs none /dev 2>/dev/null

echo
echo "==================================================="
echo "  gameboy-v3 initramfs — T113-S3 is alive."
echo "  $(uname -srm)"
echo "  cores online: $(nproc)"
echo "  >>> REMOTE-LOOP-PROOF build 20260728-A <<<"
echo "==================================================="
echo

# Hand off to an interactive shell on the console. setsid + the /dev/console
# redirection give it a controlling terminal so job control / Ctrl-C behave.
# 'exec' replaces PID 1 with the shell so we never return to the kernel.
exec setsid cttyhack /bin/sh
