# versions.env — this PRODUCT's open-source component version pins (the "what").
#
# In Buildroot these are the board defconfig's BR2_*_VERSION lines: per-product
# DATA that the generic recipe (forge/backends/*.sh, via lib.sh) reads. A second
# product reusing the engine picks its OWN kernel/uboot/busybox versions here,
# without touching the engine. The engine-tier HOST pins (cross toolchains, GNU
# make) live in forge/backends/lib.sh — those are constrained by the build host,
# not chosen per product.
#
# Strict KEY=value (bash-sourceable by lib.sh). Reproducibility: PINNED tags +
# checksums; bump deliberately, never "latest".

# --- U-Boot (SPL + U-Boot proper) --------------------------------------------
# Mainline U-Boot. T113-S3 is CONFIG_MACH_SUN8I_R528, supported since v2024.01.
# Canonical repo first, GitHub mirror as fallback (denx has transient 502s).
UBOOT_GIT_URL="https://source.denx.de/u-boot/u-boot.git"
UBOOT_GIT_URL_MIRROR="https://github.com/u-boot/u-boot.git"
UBOOT_TAG="v2026.04"
# Final combined SPL+U-Boot image (binman output), copied into build/output/.
UBOOT_IMAGE="u-boot-sunxi-with-spl.bin"

# --- Linux kernel ------------------------------------------------------------
# Mainline Linux, LTS pin. T113 board DTS landed v6.4, settled into allwinner/
# at v6.5; 6.12 is an LTS with a long support window.
KERNEL_GIT_URL="https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git"
KERNEL_GIT_URL_MIRROR="https://github.com/gregkh/linux.git"   # stable-tree mirror (same tags)
KERNEL_TAG="v6.12.95"
KERNEL_IMAGE_TARGET="zImage"              # ARMv7 compressed kernel

# --- BusyBox rootfs (static, initramfs) --------------------------------------
# Static BusyBox packed into a cpio.gz initramfs — the simplest thing that boots
# to a shell. 1.36.1 is the last release upstream labels 'stable'.
BUSYBOX_VERSION="1.36.1"
BUSYBOX_TARBALL="busybox-${BUSYBOX_VERSION}.tar.bz2"
BUSYBOX_URL="https://busybox.net/downloads/${BUSYBOX_TARBALL}"
BUSYBOX_SHA256="b8cc24c9574d809e7279c3be349795c5d5ceb6fdf19ca709f80cde50e47de314"
# Final initramfs image (raw cpio.gz — U-Boot boots it via bootz with :size).
INITRAMFS_IMAGE="initramfs.cpio.gz"
