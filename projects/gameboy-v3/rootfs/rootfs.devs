# rootfs.devs — the device table: filesystem objects that CANNOT exist as real
# files in the host staging tree (they need major/minor numbers, and creating
# real nodes would need root). Everything else in the image is discovered by
# walking the staging tree; this is the only hand-maintained part.
#
# gen_init_cpio format:
#   dir  <path> <mode> <uid> <gid>
#   nod  <path> <mode> <uid> <gid> <c|b> <major> <minor>
dir /dev          0755 0 0
nod /dev/console  0600 0 0 c 5 1
nod /dev/null     0666 0 0 c 1 3
