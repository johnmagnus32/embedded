(version 1)

# gb3 design rules beyond the netclasses in gb3.kicad_pro. KiCad applies the LAST matching rule, so
# general rules come first and the local exceptions after them.
#
# Stackup is JLC04161H-7628 (JLCPCB's default 4-layer 1.6 mm): 1 oz outer / 0.5 oz inner copper,
# 0.2104 mm 7628 prepreg (er 4.4) between each outer layer and its plane, 1.065 mm core (er 4.6),
# LPI mask er 3.8. F.Cu references the GND plane, B.Cu the +3V3 plane.
# Impedance from a 2D field solver on that cross-section (mask included, ~2% vs Hammerstad-Jensen):
#   USB pair 0.275 / 0.20 mm -> 90.7 ohm differential; 0.20 / 0.20 would be 103 ohm.
#   single-ended 50 ohm ~ 0.345 mm (nothing on this board needs it).

# ---------------------------------------------------------------- power

(rule "HighCurrent width"
	(condition "A.NetClass == 'HighCurrent'")
	(constraint track_width (min 0.6mm) (opt 0.8mm))
	(constraint via_diameter (min 0.6mm))
	(constraint hole_size (min 0.3mm)))

# 0.95 mm-pitch parts whose HighCurrent pads are 0.49-0.6 mm wide
(rule "HighCurrent neck-down, SOT-23 and USB-C pins"
	(condition "A.NetClass == 'HighCurrent' && (A.intersectsCourtyard('U2') || A.intersectsCourtyard('U6') || A.intersectsCourtyard('D4') || A.intersectsCourtyard('USBC1'))")
	(constraint track_width (min 0.4mm) (opt 0.8mm)))

# 0.5 mm-pitch QFN/DFN/MSOP parts whose HighCurrent pads are 0.25-0.28 mm wide. The fixed 0.8 mm width
# is what made the power strip unroutable on the first attempt.
(rule "HighCurrent neck-down, 0.5 mm-pitch pins"
	(condition "A.NetClass == 'HighCurrent' && (A.intersectsCourtyard('U9') || A.intersectsCourtyard('U10') || A.intersectsCourtyard('U12') || A.intersectsCourtyard('U13') || A.intersectsCourtyard('U15') || A.intersectsCourtyard('U17'))")
	(constraint track_width (min 0.25mm) (opt 0.25mm)))

# U1's pins are 0.2 mm wide on a 0.4 mm pitch
(rule "Power width"
	(condition "A.NetClass == 'Power'")
	(constraint track_width (min 0.2mm) (opt 0.4mm)))

# The charger's input-limit programming node (U10.12 ILIM, R16 3.6k, R54 1.8k via Q1): a high-impedance
# current-sense node that sets the USB input limit, so keep it short and on one layer (step 1c).
(rule "Charger ILIM node"
	(condition "A.NetName == '/charger/CHG_ILIM'")
	(constraint length (max 8mm))
	(constraint via_count (max 0)))

# ---------------------------------------------------------------- USB 2.0 HS

# USB_D+ / USB_D- (renamed from USB_DP / USB_DM 2026-10-13: KiCad pairs nets only by a +/- or P/N
# suffix). Uncoupled budget: the split around D4 (USBLC6-2SC6, D+ on pins 1/6, D- on 3/4) alone is
# ~8.9 mm at the current placement; tighten this once the pair is routed.
(rule "USB pair"
	(condition "A.inDiffPair('USB_D')")
	(constraint track_width (min 0.2mm) (opt 0.275mm))
	(constraint diff_pair_gap (min 0.18mm) (opt 0.2mm) (max 0.25mm))
	(constraint diff_pair_uncoupled (max 12mm))
	(constraint skew (max 0.5mm) (within_diff_pairs))
	# USBC1 interleaves D+/D- (B7 D-, A6 D+, A7 D-, B6 D+): tying each net's two pads takes one jumper via on
	# top of the layer change, so 3 per net is the geometric minimum (step-2 review)
	(constraint via_count (max 3)))

# ---------------------------------------------------------------- clocks and buses

(rule "24 MHz crystal"
	(condition "A.NetName == 'HOSC_IN' || A.NetName == 'HOSC_OUT'")
	(constraint via_count (max 0))
	(constraint length (max 12mm)))

# X2 sits on F.Cu directly under U1.24/25 (step 2 placement), so each RTC net takes one via up to its ball.
# The SC-20S datasheet asks for no pattern under the crystal: keep F.Cu under X2's body free (rule area at routing).
(rule "32.768 kHz crystal"
	(condition "A.NetName == 'RTC_IN' || A.NetName == 'RTC_OUT'")
	(constraint via_count (max 1))
	(constraint length (max 15mm)))

# parallel RGB, ~30 MHz pixel clock (33 ns period): 25 mm of skew is ~150 ps, still negligible. The rule
# spans the whole bus, syncs and DCLK included; 10 mm forced serpentines onto HSYNC/VSYNC for no benefit.
(rule "RGB bus matched"
	(condition "A.NetName == 'RGB_*'")
	(constraint skew (max 25mm)))

(rule "RGB pixel clock"
	(condition "A.NetName == 'RGB_DCLK'")
	(constraint via_count (max 2)))

(rule "SD bus"
	(condition "A.NetName == 'SD_CLK' || A.NetName == 'SD_CMD' || A.NetName == 'SD_D*'")
	(constraint skew (max 5mm))
	(constraint via_count (max 2)))

(rule "NOR QSPI bus"
	(condition "A.NetName == 'NOR_*'")
	(constraint skew (max 5mm))
	(constraint via_count (max 2)))
