#!/usr/bin/env bash
# os-cc — the DRIVER for our from-scratch toolchain (the gcc-front-end analogue).
#
# Our toolchain is separate programs (cpp, cc, as, ld + the runtime); a build system expects ONE compiler command that
# behaves like `gcc`. This is that front end, and it speaks gcc's command line — including the parts a build system
# PROBES with (Kbuild's cc-option / as-instr, cc-version.sh, autoconf's tryflag):
#
#     .c  --cpp-->  .i  --cc-->  .s  --as-->  .o   [ --ld-->  ELF ]
#     .S  --cpp-->  .s  --as-->  .o                (preprocessed assembly)
#     .s            --as-->  .o
#
# Modes: -E (preprocess), -S (stop at asm), -c (stop at .o), default (compile + link). `-` reads stdin (with -x);
# --version / -dumpmachine / -dumpversion / -print-file-name= / -print-libgcc-file-name answer as gcc does.
#
# THE OPTION POLICY is the point: a flag is accepted only if our tools honor it, or if it cannot change the output
# (warnings, diagnostics, optimizer latitude we don't take). Anything else — a code-generation feature we don't
# implement (-fstack-protector*, -fsanitize=, -pg, -mthumb, -g ...) — is REJECTED, so a probe
# (`cc -Werror -fstack-protector-strong -c -x c /dev/null`) fails and the build system turns the feature off, instead
# of us silently producing code without it.
#
# The real tools are installed BESIDE this script (os-cpp/os-cc1/os-as/os-ld); a link ends with our compiler runtime
# ../lib/libosrt.a (toolchain/rt — the libgcc analogue), exactly as gcc appends libgcc.
#
# The compiler's own headers (cc/include, installed as ../lib/os-cc/include) come after the -I dirs, before a sysroot's
# (-print-file-name=include names them, as gcc's).
#
# -g IS ACCEPTED, with a warning, and produces no debug information (we emit no .debug_* yet). That is gcc's own
# answer when it can't give the format asked for — `gcc -gstabs` warns "no longer supported", compiles, exits 0 — and
# a build system that passes -g unconditionally (U-Boot's KBUILD_CFLAGS/AFLAGS do) must not stop here. The levels and
# DWARF versions gcc takes are classified exactly as its driver does; -g0 asks for nothing, so it is silent.
#
# A SYSROOT (--sysroot=DIR, else ../sysroot beside bin/ when it exists — gcc's --with-sysroot) is a C library to build
# against, as gcc uses one: its headers after the -I dirs (-isystem DIR/usr/include, unless -nostdinc), and a program
# link gets its start files (crt1.o crti.o ... crtn.o; Scrt1.o for -pie, none for -shared) unless -nostdlib /
# -nostartfiles, and -lc from DIR/lib, DIR/usr/lib unless -nostdlib / -nodefaultlibs. No sysroot: nothing is added but
# the runtime (the os build's own libc passes its crt and archive itself).
set -eo pipefail

here="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
CPP="${here}/os-cpp"; CC1="${here}/os-cc1"; AS="${here}/os-as"; LD="${here}/os-ld"
RTLIB="${here}/../lib/libosrt.a"   # the compiler runtime (64-bit division, int64<->FP, ...)
CCINC="${here}/../lib/os-cc/include"; [ -d "${CCINC}" ] || CCINC="${here}/cc/include"   # the compiler's own headers (stddef.h,
                                   # stdarg.h, stdint.h, …: gcc's include/), installed beside lib/; in the source tree, cc/include
TRIPLE=arm-os-custom-linux-gnueabihf
GCCVER=13.3.0                      # the GCC we are interchangeable with (cpp's predefines say __GNUC__ 13)

die() { echo "os-cc: $*" >&2; exit 1; }
warn() { echo "os-cc: warning: $*" >&2; }
unsupported() { die "unsupported option '$1'${2:+ ($2)}"; }

mode=link            # link | compile | asm | preprocess
out=""
lang=""              # -x: c | assembler | assembler-with-cpp | "" (by extension)
cppargs=()           # -> cpp: include paths, macros, and the flags that shape the predefined macros
cc1args=()           # -> cc1: code generation (float ABI, target, PIC, unwind tables, ...)
asargs=()            # -> as: -Wa,... and the target flags gcc hands its assembler
deps=()              # -> cpp: -MD/-MMD/-MF/-MT/-MP
depsonly=""          # -M/-MM: only the dependency rule
debug_asked=""       # -g asked for debug information we don't produce yet (warned about once, after the queries)
depmode=""; depfile=""; deptarget=""
inputs=()            # sources: "lang:path"
linkobjs=()          # .o/.a already built, passed straight to ld
ttext=""; entry=""; shared=""; soname=""; linkpie=""; relocatable=""
libargs=()           # -l<name> / -L<dir>
ldextra=()           # -Wl,a,b,... -> ld
gnu89=""             # -std=gnu89/c89: `inline` is gnu89's (cc1 -fgnu89-inline)
query=""
sysroot=""; [ -d "${here}/../sysroot" ] && sysroot="$(readlink -f "${here}/../sysroot")"
nostdinc=""; nostdlib=""; nostartfiles=""; nodefaultlibs=""

need() { [ $# -ge 2 ] || die "option '$1' needs an argument"; }

while [ $# -gt 0 ]; do
  a="$1"
  case "$a" in
    # ---- mode, output, language --------------------------------------------------------------------------------
    -c) mode=compile ;;
    -E) mode=preprocess ;;
    -S) mode=asm ;;
    -o) need "$@"; out="$2"; shift ;;
    -o*) out="${a#-o}" ;;
    -x) need "$@"; case "$2" in c|assembler|assembler-with-cpp) lang="$2" ;; none) lang="" ;; *) unsupported "-x $2" "language" ;; esac; shift ;;
    -x*) case "${a#-x}" in c|assembler|assembler-with-cpp) lang="${a#-x}" ;; none) lang="" ;; *) unsupported "$a" "language" ;; esac ;;
    -) inputs+=("${lang:-stdin}:-") ;;
    -pipe|-v|-Q) ;;                                    # (we use temporary files; -v prints nothing extra)
    # ---- queries --------------------------------------------------------------------------------------------
    --version) query=version ;;
    -dumpmachine) query=machine ;;
    -dumpversion) query=dumpversion ;;
    -dumpfullversion) query=fullversion ;;
    -print-file-name=*) query="file:${a#-print-file-name=}" ;;
    -print-prog-name=*) query="prog:${a#-print-prog-name=}" ;;
    -print-libgcc-file-name) query=libgcc ;;
    # ---- the preprocessor --------------------------------------------------------------------------------------
    -I|-isystem|-idirafter|-include) need "$@"; cppargs+=("$a" "$2"); shift ;;
    -I*|-D*|-U*) cppargs+=("$a") ;;
    -iquote) need "$@"; cppargs+=("-I$2"); shift ;;    # (our cpp: one quote/angle chain)
    -nostdinc|-undef|-trigraphs|-P|-pthread|-ansi) cppargs+=("$a"); [ "$a" = -ansi ] && gnu89=1; [ "$a" = -nostdinc ] && nostdinc=1 ;;
    --sysroot=*) sysroot="${a#--sysroot=}" ;;
    --sysroot) need "$@"; sysroot="$2"; shift ;;
    -std=*) cppargs+=("$a"); case "${a#-std=}" in c89|c90|gnu89|gnu90|iso9899:1990|iso9899:199409) gnu89=1 ;; *) gnu89="" ;; esac ;;
    -fmacro-prefix-map=*|-ffile-prefix-map=*) cppargs+=("$a") ;;
    -dM) cppargs+=("$a") ;;
    -C) cppargs+=("$a") ;;                             # (our cpp drops comments either way: the same tokens)
    -CC|-H|-MG) unsupported "$a" ;;
    # dependency output: -Wp,-MD,file / -Wp,-MMD,file (Kbuild), or -MD/-MMD [-MF file] [-MT target] [-MP]
    -Wp,-MD,*|-Wp,-MMD,*) w="${a#-Wp,}"; depmode="${w%%,*}"; depfile="${w#*,}" ;;
    -Wp,*) unsupported "$a" "only -Wp,-MD,<file> / -Wp,-MMD,<file>" ;;
    -MD|-MMD) depmode="$a" ;;
    -M|-MM) depmode="-M${a#-M}D"; depsonly=1; mode=preprocess ;;   # deps only (gcc -M: implies -E; the rule, not the text)
    -MF) need "$@"; depfile="$2"; shift ;;
    -MT|-MQ) need "$@"; deptarget="$2"; shift ;;
    -MP) deps+=(-MP) ;;
    # ---- target: preprocessor + compiler + assembler agree ------------------------------------------------------
    -march=armv7-a|-mcpu=cortex-a7) cppargs+=("$a"); cc1args+=("$a"); asargs+=("$a") ;;
    -march=*|-mcpu=*) unsupported "$a" "ARMv7-A: -march=armv7-a or -mcpu=cortex-a7" ;;
    -mfpu=vfp|-mfpu=neon-vfpv4) cppargs+=("$a"); cc1args+=("$a"); asargs+=("$a") ;;
    -mfpu=*) unsupported "$a" ;;
    -mfloat-abi=soft|-mfloat-abi=hard|-msoft-float) cppargs+=("$a"); cc1args+=("$a"); asargs+=("${a/-msoft-float/-mfloat-abi=soft}") ;;
    -mfloat-abi=*) unsupported "$a" ;;
    -mgeneral-regs-only) cppargs+=("$a"); cc1args+=("$a") ;;   # the FP registers are off limits (our own kernel
                                                       # builds with it); gcc leaves the hard-float ABI alone and
                                                       # emits byte-identical code for integer-only input
    -mno-unaligned-access|-munaligned-access) cppargs+=("$a"); cc1args+=("$a") ;;   # cc1 implements both: under -mno-, an access at a known-underaligned place is split into bytes
    -marm) cppargs+=("$a"); cc1args+=("$a") ;;
    -mthumb) unsupported "$a" "our cc generates ARM code" ;;
    -mabi=aapcs-linux) ;;                              # the ABI we implement (int-sized enums, 4-byte wchar_t)
    -mabi=*) unsupported "$a" ;;
    -mlittle-endian|-EL|-mno-thumb-interwork|-mthumb-interwork|-mno-fdpic|-mno-single-pic-base|-mno-long-calls|-mtp=cp15|-mtp=auto) ;;
    -mtune=*) ;;                                       # scheduling for a core: no semantic effect
    -mword-relocations) cc1args+=("$a") ;;             # addresses as literal words, never movw/movt (U-Boot's -pie)
    -m*) unsupported "$a" ;;
    # ---- code generation we implement --------------------------------------------------------------------------
    -O|-O[0-9]|-Os|-Oz|-Og|-Ofast) cppargs+=("$a"); cc1args+=("$a") ;;
    -O*) unsupported "$a" ;;
    -fPIC|-fpic|-fPIE|-fpie) cppargs+=("$a"); cc1args+=(-fPIC) ;;
    -fno-pic|-fno-PIC|-fno-pie|-fno-PIE) cppargs+=("$a"); cc1args+=(-fno-PIC) ;;   # cc1 too: gcc is last-one-wins, so this must be able to CANCEL an earlier -fPIC
    -fvisibility=*) cc1args+=("$a") ;;
    -fshort-wchar|-fno-short-wchar) cppargs+=("$a"); cc1args+=("$a") ;;
    -funwind-tables|-fasynchronous-unwind-tables|-fno-unwind-tables|-fno-asynchronous-unwind-tables) cc1args+=("$a") ;;
    -ffreestanding|-fhosted) cppargs+=("$a") ;;
    -ffast-math|-fno-fast-math) cppargs+=("$a"); cc1args+=("$a") ;;
    -funsigned-char|-fno-signed-char) cppargs+=("$a") ;;   # ARM's plain char is unsigned: what our cc does
    -fsigned-char|-fno-unsigned-char) unsupported "$a" "our cc's plain char is unsigned (ARM)" ;;
    -fgnu89-inline) gnu89=1 ;;
    -fno-gnu89-inline) gnu89=0 ;;
    -fno-stack-protector) ;;                           # no canaries: what we do
    -ffunction-sections|-fdata-sections|-fno-function-sections|-fno-data-sections) cc1args+=("$a") ;;   # a section per function / object
    -ffixed-*) cc1args+=("$a") ;;                       # a register the code leaves alone (U-Boot's r9: gd)
    -fno-common) ;;                                    # tentative definitions are definitions: what we do
    -fwrapv|-fno-strict-overflow) ;;                   # signed overflow wraps: what our cc does
    # ---- optimizer latitude / diagnostics (no effect on our output) ----------------------------------------------
    -fno-strict-aliasing|-fstrict-aliasing|-fno-delete-null-pointer-checks|-fno-allow-store-data-races|-fno-ipa-sra|\
    -fconserve-stack|-fno-stack-check|-fno-stack-clash-protection|-fomit-frame-pointer|-fno-omit-frame-pointer|\
    -fno-optimize-sibling-calls|-fno-inline|-fno-inline-functions-called-once|-fno-inline-small-functions|\
    -fno-reorder-blocks|-fno-reorder-functions|-fno-jump-tables|-fno-gcse|-fno-crossjumping|-fno-merge-all-constants|\
    -fmerge-constants|-fno-var-tracking|-fno-var-tracking-assignments|-fno-dwarf2-cfi-asm|-fno-tree-loop-distribute-patterns|\
    -fno-semantic-interposition|-fno-exceptions|-fexcess-precision=standard|-frounding-math|-fno-math-errno|\
    -fno-builtin|-fno-builtin-*|-fno-ident|-fverbose-asm|-fno-stack-limit|-fno-plt|-fno-asm|-fno-strict-flex-arrays|\
    -fdiagnostics-*|-fmessage-length=*|-fmax-errors=*|-fno-diagnostics-*|-fno-show-column|-ftrack-macro-expansion*|\
    -fdollars-in-identifiers|--param=*|-finline-limit=*|-fno-guess-branch-probability) ;;   # (-finline-limit: how much to inline — we inline only where required)
    -falign-functions=1|-falign-functions=2|-falign-functions=4|-falign-jumps=1|-falign-labels=1|-falign-loops=1) ;;   # no padding past the
                                                       # minimum: functions are 4-aligned (ARM code), jumps/labels/loops never padded
    -falign-*) unsupported "$a" "we align functions to 4 and pad nothing else" ;;
    -f*) unsupported "$a" ;;
    -Wa,*) IFS=, read -r -a wa <<< "${a#-Wa,}"; asargs+=("${wa[@]}") ;;   # the assembler rejects what it doesn't know
    -Wl,*) IFS=, read -r -a wl <<< "${a#-Wl,}"; ldextra+=("${wl[@]}") ;;
    # Warning options (after -Wa, / -Wl, / -Wp,). We implement a FEW diagnostics as hard errors, so the
    # options that turn those on are already satisfied and only the ones that turn them OFF need to reach
    # cc1. Everything else is accepted and dropped: a build that asks for a warning we never emit should
    # compile, which is also how gcc treats a -Wno- it does not know.
    -Wno-implicit-function-declaration|-Wno-implicit|-w) cc1args+=("$a") ;;
    -Werror|-Werror=implicit-function-declaration|-Werror=implicit) cc1args+=("$a") ;;   # promotes the ones we DO emit
    -W|-W[a-z]*|-Werror=*|-pedantic|-pedantic-errors) ;;
    # -g: as gcc's driver classifies it. A level or DWARF version we understand is accepted and warned about once
    # (debug_asked); a malformed or out-of-range one is an error, in gcc's words. Retired formats (-gstabs, -gcoff,
    # -gxcoff), which gcc still warns through, are refused here instead: nothing we build uses them, and they would
    # only ever be a lie. For an assembly input gcc hands the assembler --gdwarf-<N>; ours has no line table yet, so
    # nothing is forwarded (when it does, forward it here).
    -g0|-ggdb0) ;;                                     # no debug information asked for: what we produce anyway
    -g|-ggdb|-gdwarf|-g[123]|-ggdb[123]|-gdwarf-[2345]) debug_asked=1 ;;
    -gdwarf-*) die "dwarf version ${a#-gdwarf-} is not supported" ;;
    -gdwarf[0-9]*) die "'$a' is ambiguous; use '-gdwarf-${a#-gdwarf}' for DWARF version or '-gdwarf' '-g${a#-gdwarf}' for debug level" ;;
    -g[0-9]*|-ggdb[0-9]*) die "debug output level '${a##*[a-z]}' is too high" ;;
    -g*) die "unrecognized debug output level '${a#-g}'" ;;
    -pg|-p) unsupported "$a" ;;
    # ---- linking ---------------------------------------------------------------------------------------------
    -Ttext) need "$@"; ttext="$2"; shift ;;
    -Ttext=*) ttext="${a#-Ttext=}" ;;
    -Tbss=*|-Tdata=*) unsupported "$a" "only -Ttext; place the others with a linker script" ;;
    -T) need "$@"; ldextra+=(-T "$2"); shift ;;        # a linker script, forwarded as gcc forwards it
    -T*) ldextra+=(-T "${a#-T}") ;;                    # gcc takes the name joined too (-Tboard.ld)
    -e|--entry) need "$@"; entry="$2"; shift ;;
    -shared) shared=1 ;;
    -r|--relocatable) relocatable=1 ;;                 # one relocatable object out (ld -r): no runtime, no entry
    -static-libgcc) ;;                                 # our compiler runtime is always a static archive
    -soname) need "$@"; soname="$2"; shift ;;
    -soname=*) soname="${a#-soname=}" ;;
    -l) need "$@"; libargs+=("-l$2"); shift ;;
    -l*|-L*) libargs+=("$a") ;;
    -L) need "$@"; libargs+=("-L$2"); shift ;;
    -static) ldextra+=(-static) ;;
    -nostdlib) nostdlib=1 ;;                           # no start files, no libraries (not even the runtime)
    -nostartfiles) nostartfiles=1 ;;
    -nodefaultlibs) nodefaultlibs=1 ;;
    -no-pie|-s) ;;
    -pie|--pie) linkpie=1 ;;
    -*) unsupported "$a" ;;
    # ---- inputs ----------------------------------------------------------------------------------------------
    # A suffix we compile is a source; EVERY other file is linker input, which is how gcc's driver decides it —
    # musl names its shared objects .lo and links them without a murmur. -x forces the language either way.
    *) if [ -n "${lang}" ]; then inputs+=("${lang}:$a")
       else case "$a" in *.c|*.i|*.S|*.sx|*.s) inputs+=("ext:$a") ;; *) linkobjs+=("$a") ;; esac; fi ;;
  esac
  shift
done

case "${query}" in
  version) echo "${TRIPLE}-gcc (os toolchain: our cpp/cc/as/ld) ${GCCVER}"; exit 0 ;;
  machine) echo "${TRIPLE}"; exit 0 ;;
  dumpversion) echo "${GCCVER%%.*}"; exit 0 ;;
  fullversion) echo "${GCCVER}"; exit 0 ;;
  file:*) n="${query#file:}"; [ "${n}" = libgcc.a ] || [ "${n}" = libosrt.a ] && { echo "$(readlink -f "${RTLIB}")"; exit 0; }
          [ "${n}" = include ] && [ -d "${CCINC}" ] && { readlink -f "${CCINC}"; exit 0; }   # (Kbuild/U-Boot: -nostdinc -isystem this)
          echo "${n}"; exit 0 ;;   # (gcc: the name itself when not found)
  prog:*) n="${query#prog:}"; case "${n}" in as) echo "${AS}" ;; ld) echo "${LD}" ;; cpp) echo "${CPP}" ;; *) echo "${n}" ;; esac; exit 0 ;;
  libgcc) echo "$(readlink -f "${RTLIB}")"; exit 0 ;;
esac

# Said once per invocation, like gcc's for a format it can't produce, and after the -print-* queries so a build
# system's capability probes stay quiet.
[ -z "${debug_asked}" ] || warn "no debug information is produced (-g accepted, no .debug_* sections emitted)"

[ -n "${nostdinc}" ] || [ ! -d "${CCINC}" ] || cppargs+=(-isystem "${CCINC}")   # the compiler's headers, then the C library's: gcc's order
if [ -n "${sysroot}" ]; then
  [ -d "${sysroot}" ] || die "--sysroot ${sysroot}: not a directory"
  [ -n "${nostdinc}" ] || cppargs+=(-isystem "${sysroot}/usr/include")   # (after every -I: gcc's order)
fi
[ ${#inputs[@]} -gt 0 ] || [ ${#linkobjs[@]} -gt 0 ] || die "no input files"
if [ "${mode}" != link ] && [ ${#linkobjs[@]} -gt 0 ]; then   # gcc names each one and carries on
  for f in "${linkobjs[@]}"; do warn "${f}: linker input file unused because linking not done"; done
  linkobjs=()
fi
[ "${gnu89}" = 1 ] && cc1args+=(-fgnu89-inline)
asargs=(-meabi=5 "${asargs[@]}")                       # what gcc tells its assembler (EABI 5, then the target, then -Wa)

tmp="$(mktemp -d)"; trap 'rm -rf "${tmp}"' EXIT

# the dependency file cpp writes (Kbuild's fixdep reads it); its target: the object
depflags() {   # depflags <object>
  [ -n "${depmode}" ] || return 0
  local f="${depfile}"
  if [ -n "${depsonly}" ]; then   # -M/-MM: cpp's own default target (the source's .o) unless -MT; the rule to a file of ours
    [ -n "${f}" ] || f="${tmp}/deps.d"
    printf '%s\n' "${depmode}" -MF "${f}" "${deps[@]}"; [ -n "${deptarget}" ] && printf '%s\n' -MT "${deptarget}"
    return 0
  fi
  [ -n "${f}" ] || { f="${1%.o}.d"; }
  printf '%s\n' "${depmode}" -MF "${f}" -MT "${deptarget:-$1}" "${deps[@]}"
}
deps_out() {   # deps_out <dst>: -M/-MM's rule — to stdout (or -o), unless -MF named its file
  [ -n "${depfile}" ] && return 0
  if [ "$1" = - ]; then cat "${tmp}/deps.d"; else cp "${tmp}/deps.d" "$1"; fi
}

# compile_one <lang:src> <dst|-> : one source through cpp[/cc]/as, honoring the stop mode (-E/-S: dst "-" = stdout)
compile_one() {
  local spec="$1" dst="$2" kind="${1%%:*}" src="${1#*:}" i="${tmp}/u.i" s="${tmp}/u.s"
  if [ "${src}" = - ]; then                            # stdin: needs -x (gcc: "-E or -x required when input is from stdin")
    case "${kind}" in c) cat > "${tmp}/stdin.c"; src="${tmp}/stdin.c" ;; assembler-with-cpp) cat > "${tmp}/stdin.S"; src="${tmp}/stdin.S" ;;
      assembler) cat > "${tmp}/stdin.s"; src="${tmp}/stdin.s" ;; stdin) [ "${mode}" = preprocess ] || die "-x required when input is from standard input"; cat > "${tmp}/stdin.c"; src="${tmp}/stdin.c" ;; esac
    kind=ext
  fi
  if [ "${kind}" = ext ]; then
    case "${src}" in *.c) kind=c ;; *.i) kind=i ;; *.S|*.sx) kind=assembler-with-cpp ;; *.s) kind=assembler ;;
      *) die "internal: no language for ${src} (a suffix we don't compile is linker input)" ;; esac
  fi
  local df=(); mapfile -t df < <(depflags "${dst}")
  case "${kind}" in
    c)
      "${CPP}" "${cppargs[@]}" "${df[@]}" -o "${i}" "${src}"
      [ -n "${depsonly}" ] && { deps_out "${dst}"; return 0; }
      [ "${mode}" = preprocess ] && { if [ "${dst}" = - ]; then cat "${i}"; else cp "${i}" "${dst}"; fi; return 0; }
      "${CC1}" "${cc1args[@]}" -o "${s}" "${i}"
      ;;
    i)
      [ "${mode}" = preprocess ] && { if [ "${dst}" = - ]; then cat "${src}"; else cp "${src}" "${dst}"; fi; return 0; }
      "${CC1}" "${cc1args[@]}" -o "${s}" "${src}"
      ;;
    assembler-with-cpp)
      "${CPP}" -x assembler-with-cpp "${cppargs[@]}" "${df[@]}" -o "${s}" "${src}"
      [ -n "${depsonly}" ] && { deps_out "${dst}"; return 0; }
      [ "${mode}" = preprocess ] && { if [ "${dst}" = - ]; then cat "${s}"; else cp "${s}" "${dst}"; fi; return 0; }
      ;;
    assembler)
      [ "${mode}" = preprocess ] && { if [ "${dst}" = - ]; then cat "${src}"; else cp "${src}" "${dst}"; fi; return 0; }
      cp "${src}" "${s}"
      ;;
  esac
  if [ "${mode}" = asm ]; then                         # stop at assembly
    if [ "${dst}" = - ]; then cat "${s}"; else cp "${s}" "${dst}"; fi; return 0
  fi
  "${AS}" "${asargs[@]}" -o "${dst}" "${s}"
}

# --- non-link modes: each input on its own ---------------------------------------------------------------------
if [ "${mode}" != link ]; then
  [ -z "${out}" ] || [ ${#inputs[@]} -le 1 ] || die "cannot specify -o with -c, -S or -E with multiple files"
  for spec in "${inputs[@]}"; do
    src="${spec#*:}"
    if [ -n "${out}" ]; then d="${out}"; [ "${mode}" = preprocess ] && [ "${out}" = - ] && d=-
    elif [ "${mode}" = preprocess ]; then d=-
    else base="$(basename "${src}")"; [ "${src}" = - ] && base=stdin; base="${base%.*}"; [ "${mode}" = compile ] && d="${base}.o" || d="${base}.s"
    fi
    compile_one "${spec}" "${d}"
  done
  exit 0
fi

# --- link mode: every source to a temp .o, then ld everything into one ELF --------------------------------------
objs=(); n=0
for spec in "${inputs[@]}"; do
  o="${tmp}/obj${n}.o"; compile_one "${spec}" "${o}"; objs+=("${o}"); n=$((n + 1))
done
: "${out:=a.out}"
ldflags=()
if [ -n "${relocatable}" ]; then                     # a partial link: the objects merged, nothing resolved or added
  [ -z "${shared}${linkpie}${ttext}${entry}" ] || die "-r makes an object: no -shared, -pie, -Ttext or -e"
  "${LD}" -r "${ldextra[@]}" -o "${out}" "${objs[@]}" "${linkobjs[@]}" "${libargs[@]}"
  exit 0
fi
if [ -n "${shared}" ]; then                  # a .so: ET_DYN, base 0, no entry — -Ttext/-e don't apply
  ldflags+=(-shared)
  [ -n "${soname}" ] && ldflags+=(-soname "${soname}")
else
  [ -n "${linkpie}" ] && ldflags+=(-pie)
  [ -n "${ttext}" ] && ldflags+=(-Ttext "${ttext}")
  [ -n "${entry}" ] && ldflags+=(-e "${entry}")
fi
start=(); finish=(); libs=()
if [ -n "${sysroot}" ]; then                         # gcc's link line against a C library
  sysfile() { local f; for f in "${sysroot}/usr/lib/$1" "${sysroot}/lib/$1"; do [ -f "${f}" ] && { echo "${f}"; return; }; done; die "--sysroot ${sysroot}: no $1"; }
  if [ -z "${nostdlib}${nostartfiles}" ]; then
    if [ -n "${shared}" ]; then start=("$(sysfile crti.o)")
    elif [ -n "${linkpie}" ]; then start=("$(sysfile Scrt1.o)" "$(sysfile crti.o)")
    else start=("$(sysfile crt1.o)" "$(sysfile crti.o)"); fi
    finish=("$(sysfile crtn.o)")
  fi
  ldflags+=(-L "${sysroot}/lib" -L "${sysroot}/usr/lib")
  [ -n "${nostdlib}${nodefaultlibs}" ] || libs+=(-lc)
fi
if [ -z "${nostdlib}${nodefaultlibs}" ]; then          # the compiler runtime, last (gcc's libgcc)
  [ -f "${RTLIB}" ] || die "compiler runtime ${RTLIB} missing (build toolchain/rt and install it beside bin/)"
  libs+=("${RTLIB}")
fi
"${LD}" "${ldflags[@]}" "${ldextra[@]}" -o "${out}" "${start[@]}" "${objs[@]}" "${linkobjs[@]}" "${libargs[@]}" "${libs[@]}" "${finish[@]}"
